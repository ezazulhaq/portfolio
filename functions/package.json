{
  "name": "portfolio-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Ezazul's Portfolio Digital Twin Chatbot",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  },
  "private": true
}

